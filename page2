<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>FreshBite - Food Ordering App</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
      background: #f9f9f9;
    }
    header {
      background-color: #e74c3c;
      color: white;
      padding: 1rem;
      text-align: center;
    }
    nav {
      background-color: #333;
      color: white;
      display: flex;
      justify-content: center;
      padding: 0.5rem;
    }
    nav a {
      color: white;
      margin: 0 1rem;
      text-decoration: none;
    }
    .menu {
      padding: 2rem;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
    }
    .item {
      background: white;
      padding: 1rem;
      border-radius: 10px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }
    .item h3 {
      margin-top: 0;
    }
    .footer {
      background: #222;
      color: white;
      text-align: center;
      padding: 1rem;
      margin-top: 2rem;
    }
  </style>
</head>
<body>

  <header>
    <h1>FreshBite</h1>
    <p>Your favorite food, delivered fresh!</p>
  </header>

  <nav>
    <a href="#menu">Menu</a>
    <a href="#contact">Contact</a>
  </nav>

  <section class="menu" id="menu">
    <div class="item">
      <h3>Margherita Pizza</h3>
      <p>Fresh tomatoes, mozzarella, basil</p>
      <p><strong>$9.99</strong></p>
    </div>
    <div class="item">
      <h3>Chicken Burger</h3>
      <p>Grilled chicken, lettuce, mayo</p>
      <p><strong>$7.99</strong></p>
    </div>
    <div class="item">
      <h3>Vegan Bowl</h3>
      <p>Quinoa, chickpeas, avocado</p>
      <p><strong>$8.99</strong></p>
    </div>
  </section>

  <footer class="footer" id="contact">
    <p>Contact us at: hello@freshbite.com | (123) 456-7890</p>
  </footer>

</body>
</html>
